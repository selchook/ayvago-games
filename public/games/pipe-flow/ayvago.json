{
  "$schema": "https://ayvago.com/schemas/manifest.v1.json",
  "id": "pipeflow",
  "title": {
    "en": "Pipe Flow",
    "tr": "Boru Akışı"
  },
  "description": {
    "en": "Rotate the pipes to connect the source to the drain before the water starts to flow. You can still turn pipes ahead of the water; every level grows the grid and speeds up the flow.",
    "tr": "Su akmaya başlamadan boruları döndür ve kaynağı gidere bağla. Su yolda ilerlerken bile önündeki boruları çevirebilirsin; her bölümde ızgara büyür, su hızlanır."
  },
  "category": "puzzle",
  "categories": [
    "puzzle",
    "casual",
    "strategy"
  ],
  "tags": [
    "pipe",
    "flow",
    "retro"
  ],
  "entry": "https://ayvago-games.vercel.app/games/pipe-flow/",
  "orientation": "portrait",
  "input": [
    "touch",
    "keyboard",
    "mouse"
  ],
  "players": {
    "min": 1,
    "max": 1
  },
  "scoring": {
    "metric": "points",
    "order": "desc",
    "format": "number",
    "label": {
      "en": "Score",
      "tr": "Puan"
    },
    "minDurationMs": 3000,
    "maxPerSecond": 1000,
    "maxScore": 10000000
  },
  "ads": {
    "rewarded": [],
    "interstitial": []
  },
  "ageRating": "3+",
  "sdkVersion": 2,
  "assets": {
    "icon": "/games/pipe-flow/ayvago/icon-512.png",
    "cover": "/games/pipe-flow/ayvago/cover-1920x1080.jpg",
