      "en": "Score",
      "tr": "Puan"
    },
    "minDurationMs": 3000,
    "maxPerSecond": 1000,
    "maxScore": 10000000
  },
  "ads": {
    "rewarded": [],
    "interstitial": []
  },
  "ageRating": "3+",
  "sdkVersion": 2,
  "assets": {
    "icon": "/games/slide-puzzle/ayvago/icon-512.png",
    "cover": "/games/slide-puzzle/ayvago/cover-1920x1080.jpg",
