{
  "$schema": "https://ayvago.com/schemas/manifest.v1.json",
  "id": "slidepuzzle",
  "title": {
    "en": "Slide Puzzle",
    "tr": "Kaydırmalı Bulmaca"
  },
  "description": {
    "en": "Slide the scrambled number tiles into the gap until they are back in order. Warm up on 3×3, master 4×4 and 5×5; fewer moves and less time score more.",
    "tr": "Karışık sayı karolarını boşluğa kaydırarak sıraya diz. 3×3 ile ısın, 4×4 ve 5×5 ile ustalaş; az hamle ve kısa süre daha çok puan getirir."
  },
  "category": "puzzle",
  "categories": [
    "puzzle",
    "casual",
    "retro"
  ],
  "tags": [
    "slide",
    "puzzle",
    "retro"
  ],
  "entry": "https://ayvago-games.vercel.app/games/slide-puzzle/",
  "orientation": "portrait",
  "input": [
    "touch",
    "keyboard",
    "mouse"
  ],
  "players": {
    "min": 1,
    "max": 1
  },
  "scoring": {
    "metric": "points",
    "order": "desc",
    "format": "number",
