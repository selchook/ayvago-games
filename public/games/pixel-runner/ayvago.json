{
  "$schema": "https://ayvago.com/schemas/manifest.v1.json",
  "id": "pixelrunner",
  "title": {
    "en": "Pixel Runner",
    "tr": "Piksel Koşucu"
  },
  "description": {
    "en": "Never stop running! Leap over pits, stomp enemies and grab coins. The further you go, the faster it gets.",
    "tr": "Durmadan koş! Çukurların üstünden zıpla, düşmanların kafasına bas, altınları topla. Koştukça hız artar."
  },
  "category": "action",
  "categories": [
    "action",
    "arcade",
    "retro"
  ],
  "tags": [
    "pixel",
    "runner",
    "retro"
  ],
  "entry": "https://ayvago-games.vercel.app/games/pixel-runner/",
  "orientation": "landscape",
  "input": [
    "touch",
    "keyboard",
    "mouse"
  ],
  "players": {
    "min": 1,
    "max": 1
  },
  "scoring": {
    "metric": "points",
    "order": "desc",
    "format": "number",
    "label": {
      "en": "Score",
      "tr": "Puan"
    },
    "minDurationMs": 3000,
    "maxPerSecond": 1000,
    "maxScore": 10000000
  },
  "ads": {
    "rewarded": [],
    "interstitial": []
  },
  "ageRating": "3+",
  "sdkVersion": 2,
  "assets": {
    "icon": "/games/pixel-runner/ayvago/icon-512.png",
    "cover": "/games/pixel-runner/ayvago/cover-1920x1080.jpg",
    "screenshot": "/games/pixel-runner/ayvago/screenshot.jpg"
  },
  "version": "1.0.0"
}
