{
  "$schema": "https://ayvago.com/schemas/manifest.v1.json",
  "id": "skyjumper",
  "title": {
    "en": "Sky Jumper",
    "tr": "Gök Zıplayıcı"
  },
  "description": {
    "en": "Bounce your character up into the sky: ride springs, blast off with a jetpack and dodge breaking platforms and monsters.",
    "tr": "Karakterini bulutların üstüne zıplat: yaylarla uç, jet sırt çantasıyla fırla, kırılan platformlardan ve yaratıklardan sakın."
  },
  "category": "arcade",
  "categories": [
    "arcade",
    "casual"
  ],
  "tags": [
    "sky",
    "jumper",
    "retro"
  ],
  "entry": "https://ayvago-games.vercel.app/games/sky-jumper/",
  "orientation": "portrait",
  "input": [
    "touch",
    "keyboard",
    "mouse"
  ],
  "players": {
    "min": 1,
    "max": 1
  },
  "scoring": {
    "metric": "points",
    "order": "desc",
    "format": "number",
    "label": {
      "en": "Score",
      "tr": "Puan"
    },
    "minDurationMs": 3000,
    "maxPerSecond": 1000,
    "maxScore": 10000000
  },
  "ads": {
    "rewarded": [],
    "interstitial": []
  },
  "ageRating": "3+",
  "sdkVersion": 2,
  "assets": {
    "icon": "/games/sky-jumper/ayvago/icon-512.png",
    "cover": "/games/sky-jumper/ayvago/cover-1920x1080.jpg",
    "screenshot": "/games/sky-jumper/ayvago/screenshot.jpg"
  },
  "version": "1.0.0"
}
