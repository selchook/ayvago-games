{
  "$schema": "https://ayvago.com/schemas/manifest.v1.json",
  "id": "dungeondash",
  "title": {
    "en": "Dungeon Dash",
    "tr": "Zindan Koşusu"
  },
  "description": {
    "en": "A turn-based micro roguelike: fight monsters, grab potions and chests, take the stairs ever deeper.",
    "tr": "Sıra tabanlı mini zindan macerası: canavarlarla savaş, iksir ve sandık topla, merdivenden aşağı in."
  },
  "category": "strategy",
  "categories": [
    "strategy",
    "retro",
    "puzzle"
  ],
  "tags": [
    "dungeon",
    "dash",
    "retro"
  ],
  "entry": "https://ayvago-games.vercel.app/games/dungeon-dash/",
  "orientation": "portrait",
  "input": [
    "touch",
    "keyboard",
    "mouse"
  ],
  "players": {
    "min": 1,
    "max": 1
  },
  "scoring": {
    "metric": "points",
    "order": "desc",
    "format": "number",
    "label": {
      "en": "Score",
      "tr": "Puan"
    },
    "minDurationMs": 3000,
    "maxPerSecond": 1000,
    "maxScore": 10000000
  },
  "ads": {
    "rewarded": [],
    "interstitial": []
  },
  "ageRating": "3+",
  "sdkVersion": 2,
  "assets": {
    "icon": "/games/dungeon-dash/ayvago/icon-512.png",
    "cover": "/games/dungeon-dash/ayvago/cover-1920x1080.jpg",
    "screenshot": "/games/dungeon-dash/ayvago/screenshot.jpg"
  },
  "version": "1.0.0"
}
