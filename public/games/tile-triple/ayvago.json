    "minDurationMs": 3000,
    "maxPerSecond": 1000,
    "maxScore": 10000000
  },
  "ads": {
    "rewarded": [],
    "interstitial": []
  },
  "ageRating": "3+",
  "sdkVersion": 2,
  "assets": {
    "icon": "/games/tile-triple/ayvago/icon-512.png",
    "cover": "/games/tile-triple/ayvago/cover-1920x1080.jpg",
