{
  "$schema": "https://ayvago.com/schemas/manifest.v1.json",
  "id": "tiletriple",
  "title": {
    "en": "Tile Triple",
    "tr": "Üçlü Taş"
  },
  "description": {
    "en": "Pick stacked animal tiles into the tray and match three of a kind to clear them. Empty every layer before the tray fills up!",
    "tr": "Üst üste yığılmış hayvan taşlarını tepsiye al, aynı üç taşı eşleştirip yok et. Tepsi dolmadan her katmanı temizle!"
  },
  "category": "puzzle",
  "categories": [
    "puzzle",
    "casual"
  ],
  "tags": [
    "tile",
    "triple",
    "retro"
  ],
  "entry": "https://ayvago-games.vercel.app/games/tile-triple/",
  "orientation": "portrait",
  "input": [
    "touch",
    "keyboard",
    "mouse"
  ],
  "players": {
    "min": 1,
    "max": 1
  },
  "scoring": {
    "metric": "points",
    "order": "desc",
    "format": "number",
    "label": {
      "en": "Score",
      "tr": "Puan"
