    "arcade",
    "casual"
  ],
  "tags": [
    "color",
    "gate",
    "retro"
  ],
  "entry": "https://ayvago-games.vercel.app/games/color-gate/",
  "orientation": "portrait",
  "input": [
    "touch",
    "keyboard",
    "mouse"
  ],
  "players": {
