{
  "$schema": "https://ayvago.com/schemas/manifest.v1.json",
  "id": "shootinggallery",
  "title": {
    "en": "Shooting Gallery",
    "tr": "Atış Poligonu"
  },
  "description": {
    "en": "Pop the sliding ducks and targets at the fairground stall. Reach each round's score goal before the clock runs out.",
    "tr": "Panayır atış poligonunda kayan ördekleri ve hedefleri vur. Her turda süre dolmadan puan hedefini tuttur."
  },
  "category": "arcade",
  "categories": [
    "arcade",
    "casual",
    "sports"
  ],
  "tags": [
    "shooting",
    "gallery",
    "retro"
  ],
  "entry": "https://ayvago-games.vercel.app/games/shooting-gallery/",
  "orientation": "landscape",
  "input": [
    "touch",
    "keyboard",
    "mouse"
  ],
  "players": {
    "min": 1,
    "max": 1
  },
  "scoring": {
    "metric": "points",
    "order": "desc",
