    "maxScore": 10000000
  },
  "ads": {
    "rewarded": [],
    "interstitial": []
  },
  "ageRating": "3+",
  "sdkVersion": 2,
  "assets": {
    "icon": "/games/shooting-gallery/ayvago/icon-512.png",
    "cover": "/games/shooting-gallery/ayvago/cover-1920x1080.jpg",
