{
  "name": "ayvago-games",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/gen-registry.mjs && tsc --noEmit && vite build",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc --noEmit",
    "registry": "node scripts/gen-registry.mjs",
    "new-game": "node scripts/new-game.mjs",
    "test:smoke": "node scripts/smoke-test.mjs",
    "test:platform": "node scripts/platform-harness.mjs",
    "platform": "node scripts/gen-platform.mjs",
    "store-assets": "node scripts/gen-store-assets.mjs",
    "release": "npm run build && node scripts/gen-platform.mjs && npm run build && npm run test:smoke && npm run test:platform && node scripts/gen-store-assets.mjs && npm run validate:platform",
    "validate:platform": "tsx scripts/validate-manifests.ts",
    "test:mp": "node scripts/mp-harness.mjs"
  },
  "devDependencies": {
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~5.9.0",
    "vite": "^7.1.0",
    "zod": "^4.6.7"
  },
  "dependencies": {
    "@fontsource/pixelify-sans": "^5.3.0",
    "@fontsource/press-start-2p": "^5.3.0",
    "phaser": "3.90.0"
  }
}
